{
  "prompt_injection": {
    "allowlist_patterns": [
      "__init__",
      "__import__",
      "__class__",
      "__globals__",
      "__builtins__",
      "__mro__",
      "__subclasses__"
    ]
  },
  "permissions": {
    "rules": [
      {
        "mode": "allow",
        "matcher": "mcp__lore__*",
        "patterns": [
          "mcp__lore__*"
        ]
      }
    ]
  }
}
